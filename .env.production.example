# Public HTTPS origin routed to the frontend container.
ALLOWED_ORIGIN=https://verify.example.com
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
SESSION_COOKIE_SECURE=true
TRUST_PROXY=true

# Private PostgreSQL/RDS connection. Use a runtime user, not the RDS master user.
DATABASE_URL=postgresql://patient_verify_app:CHANGE_ME@private-db.example.internal:5432/patient_verify
DB_SSL_MODE=verify-full
DB_POOL_MAX=5
RDS_CA_CERT_FILE=/opt/patient-verify/secrets/rds-ca.pem

# Private S3 bucket. On EC2, grant access through an IAM instance role.
AWS_REGION=ap-southeast-1
S3_IMAGE_BUCKET=patient-verify-private-images
VERIFICATION_BATCH_ID=

# One-time bootstrap account used by deploy.sh. Password must be at least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD

# Optional image names/tags.
BACKEND_IMAGE=patient-verify-backend:latest
FRONTEND_IMAGE=patient-verify-frontend:latest
