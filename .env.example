# Khi chạy backend ngoài Compose:
# DATABASE_URL=postgresql://app_user:password@private-rds-host:5432/patient_verify
# DB_SSL_MODE=verify-full
# DATABASE_CA_CERT_FILE=/run/secrets/rds-ca.pem
